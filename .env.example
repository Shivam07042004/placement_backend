# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
ENVIRONMENT=production
CORS_ALLOW_ALL_ORIGINS=True

# MySQL Database Configuration (legacy / fallback)
MYSQLDATABASE=your_database_name
MYSQLUSER=your_db_user
MYSQLPASSWORD=your_db_password
MYSQLHOST=your_db_host
MYSQLPORT=3306

# TiDB Cloud Configuration (recommended for TiDB)
TIDB_DATABASE=your_tidb_database_name
TIDB_USERNAME=your_tidb_username
TIDB_PASSWORD=your_tidb_password
TIDB_HOST=your_tidb_gateway_host
TIDB_PORT=4000

# TLS settings for TiDB Cloud
# Set TIDB_SSL_CA to the CA cert file path if needed by your environment.
# Example Linux: /etc/ssl/certs/ca-certificates.crt
# Example Windows: C:\\path\\to\\ca.pem
TIDB_SSL_CA=
TIDB_SSL_DISABLE=False

# Optional DB pool tuning
DB_CONN_MAX_AGE=60
